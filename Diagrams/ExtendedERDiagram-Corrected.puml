@startuml
' Extended ER Diagram in Chen-like report format
left to right direction
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam usecase {
  BackgroundColor white
  BorderColor black
}

' ---------- Entities ----------
rectangle "User" as USER
rectangle "Quiz_Attempt" as ATTEMPT
rectangle "Question_Attempt\n(Weak Entity)" as QATTEMPT

' ---------- Relationship nodes (diamond-like labels) ----------
rectangle "MAKES" as R1
rectangle "CONTAINS\n(Identifying)" as R2

' ---------- User attributes ----------
usecase "<u>user_id</u>" as U_ID
usecase "name" as U_NAME
usecase "email (unique)" as U_EMAIL
usecase "password" as U_PASS
usecase "created_at" as U_CREATED
usecase "updated_at" as U_UPDATED

' ---------- Attempt attributes ----------
usecase "<u>attempt_id</u>" as A_ID
usecase "user_id (FK)" as A_USER
usecase "quiz_type\n{PREDEFINED, AI}" as A_TYPE
usecase "correct_count" as A_CORRECT
usecase "total_questions" as A_TOTAL
usecase "percentage" as A_PERCENT
usecase "attempt_time" as A_TIME

' ---------- QuestionAttempt attributes ----------
usecase "<u>question_text</u>\n(partial key)" as Q_TEXT
usecase "options\n{multivalued}" as Q_OPTIONS
usecase "correct_answer" as Q_CORRECT
usecase "user_answer (nullable)" as Q_USER
usecase "explanation (nullable)" as Q_EXPL
usecase "topic (nullable)" as Q_TOPIC

' ---------- Entity-attribute links ----------
USER -- U_ID
USER -- U_NAME
USER -- U_EMAIL
USER -- U_PASS
USER -- U_CREATED
USER -- U_UPDATED

ATTEMPT -- A_ID
ATTEMPT -- A_USER
ATTEMPT -- A_TYPE
ATTEMPT -- A_CORRECT
ATTEMPT -- A_TOTAL
ATTEMPT -- A_PERCENT
ATTEMPT -- A_TIME

QATTEMPT -- Q_TEXT
QATTEMPT -- Q_OPTIONS
QATTEMPT -- Q_CORRECT
QATTEMPT -- Q_USER
QATTEMPT -- Q_EXPL
QATTEMPT -- Q_TOPIC

' ---------- Relationship links with cardinality ----------
USER -- R1 : 1
R1 -- ATTEMPT : N

ATTEMPT -- R2 : 1
R2 -- QATTEMPT : N

note right of QATTEMPT
Stored as embedded array:
questions[] inside Quiz_Attempt
end note

@enduml
