@startuml
left to right direction
skinparam shadowing false

rectangle "AI Quiz System (Process 0)" as System
actor User
database "MongoDB\n(users, quiz_attempts)" as DB
rectangle "Gemini API" as AI

User --> System : register/login,\nquiz input, answers,\nhistory request
System --> User : auth status,\nquiz questions,\nresult+summary,\nhistory data

System --> DB : create/read user,\nsave/read attempts
DB --> System : user/attempt data

System --> AI : generate quiz,\ngenerate summary
AI --> System : AI questions,\nfeedback summary

@enduml
